# Production service settings. Use npm run local:setup for local development.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pms_viewer
AUTH_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=false
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=104857600
PDF_MAX_PAGES=50
# Each worker process handles one job. Scale worker replicas for concurrency.
RENDER_TIMEOUT_SECONDS=120
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BUDGET_USD=
AI_ARTWORK_POLICY_ACCEPTED=false
AI_MAX_CALLS_PER_DAY=0
AI_MAX_OUTPUT_TOKENS=2000
# AI_BUDGET_USD is an operator/provider-side budget; the application enforces call/output-token ceilings.
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=
PYTHON_EXECUTABLE=python
PROCESSOR_PATH=
