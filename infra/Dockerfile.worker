FROM node:24.14.1-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN npm ci && python3 -m venv /opt/processor && /opt/processor/bin/pip install --no-cache-dir -r services/processor/requirements.txt && chown -R node:node /app
ENV NODE_ENV=production PYTHON_EXECUTABLE=/opt/processor/bin/python PROCESSOR_PATH=/app/services/processor/process.py
USER node
CMD ["node", "--import", "tsx", "apps/worker/index.ts"]
