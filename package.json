{
  "name": "pms-viewer-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "local:setup": "tsx scripts/local-setup.ts",
    "local:db": "node --env-file=.env --import tsx scripts/local-db.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/index.ts",
    "assets": "node scripts/copy-pdfjs.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "dev": "npm run dev --workspace=@pms/web --",
    "build": "npm run build --workspace=@pms/web",
    "start": "npm run start --workspace=@pms/web --",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "test": "node --import tsx --test tests/geometry.test.ts tests/ai.test.ts tests/mapping.test.ts",
    "test:integration": "node --env-file=.env --import tsx tests/integration.ts",
    "test:browser": "node tests/browser-check.mjs",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
